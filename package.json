{
  "name": "@antondanv/treeyard",
  "version": "0.1.0",
  "description": "A goal tree for Agent-Driven Development in your terminal: a “done when” on every node, and Claude Code, Codex, Antigravity and OpenCode sessions opened from its nodes.",
  "keywords": [
    "agent-driven-development",
    "goal-tree",
    "planning",
    "tui",
    "cli",
    "agents",
    "claude-code",
    "codex",
    "antigravity",
    "opencode",
    "vibe-coding"
  ],
  "license": "MIT",
  "author": "Anton Danilov",
  "homepage": "https://github.com/antondanv/treeyard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antondanv/treeyard.git"
  },
  "bugs": {
    "url": "https://github.com/antondanv/treeyard/issues"
  },
  "type": "module",
  "bin": {
    "treeyard": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/chmod.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli/main.ts",
    "screenshots": "tsx scripts/readme-screenshots.ts",
    "prepack": "npm run build && node scripts/npm-readme.mjs hide",
    "postpack": "node scripts/npm-readme.mjs show"
  },
  "dependencies": {
    "@antondanv/brainyard": "^0.2.0",
    "ink": "^7.1.1",
    "pngjs": "^7.0.0",
    "react": "^19.2.0",
    "string-width": "^8.3.0",
    "wrap-ansi": "^10.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
